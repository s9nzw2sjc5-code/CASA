rules_version = '2';
// Solo las personas de esta lista pueden leer y escribir los datos de la casa.
// Cambia los emails por los vuestros y pégalo en Firebase → Firestore → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['tu-email@gmail.com', 'email-de-juanma@gmail.com'];
    }
  }
}
